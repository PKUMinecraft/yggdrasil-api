{% extends 'user.base' %}

{% block title %}绑定正版账号{% endblock %}

{% block content %}
<div class="container-fluid">
  <div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">

      {% if success %}
      <div class="alert alert-success alert-dismissible">
        <button type="button" class="close" data-dismiss="alert">&times;</button>
        {{ success }}
      </div>
      {% endif %}

      {% if error %}
      <div class="alert alert-danger alert-dismissible">
        <button type="button" class="close" data-dismiss="alert">&times;</button>
        {{ error }}
      </div>
      {% endif %}

      {% if binding %}

        <div class="card card-success">
          <div class="card-header">
            <h3 class="card-title"><i class="fas fa-link mr-2"></i>已绑定正版账号</h3>
          </div>
          <div class="card-body">
            <div class="form-group mb-2">
              <label class="text-muted small">Mojang UUID</label>
              <input type="text" class="form-control form-control-sm"
                value="{{ binding.mojang_uuid }}" readonly>
            </div>
            <p class="text-muted small mb-0">
              绑定后可用正版账号登录 Minecraft 并直接加入服务器，与皮肤站账号共享同一角色数据。
            </p>
          </div>
          <div class="card-footer">
            <form method="POST" action="{{ url('yggdrasil/mojang/unbind') }}">
              {{ csrf_field() }}
              <button type="submit" class="btn btn-outline-danger btn-block"
                onclick="return confirm('确认解除正版账号绑定？解除后需重新验证才能用正版账号登录并加入服务器。')">
                <i class="fas fa-unlink mr-1"></i>解除绑定
              </button>
            </form>
          </div>
        </div>

      {% elseif pending %}

        <div class="card card-warning">
          <div class="card-header">
            <h3 class="card-title"><i class="fas fa-clock mr-2"></i>等待验证中</h3>
          </div>
          <div class="card-body">
            <div class="d-flex align-items-center mb-3">
              {% if pending.mojang_uuid %}
              <img src="https://mc-heads.net/avatar/{{ pending.mojang_uuid }}/48"
                alt="" width="48" height="48" class="mr-3 rounded"
                onerror="this.style.display='none'">
              {% endif %}
              <div>
                <div class="text-muted small">已从 Mojang 确认正版账号</div>
                <strong style="font-size:1.1em;">{{ pending.mojang_name }}</strong>
              </div>
            </div>
            <div class="callout callout-info mb-3">
              请核对上方是否为你本人的正版账号。如不正确，请取消申请后重新提交。
            </div>
            <p class="mb-1 font-weight-bold">接下来：</p>
            <ol class="mb-0" style="padding-left: 1.75rem; list-style-position: outside; line-height: 1.6;">
              <li class="mb-2">在任意支持正版登录的启动器中，使用正版账号登录 Minecraft（无需安装外置登录）</li>
              <li class="mb-2">用 <strong>{{ pending.mojang_name }}</strong> 加入本服务器</li>
              <li>在连接提示中取得验证码，填写到下方确认</li>
            </ol>
            <p class="text-muted small mt-2 mb-0">申请在 15 分钟内有效。</p>
            <form method="POST" action="{{ url('yggdrasil/mojang/confirm-bind') }}" class="mt-3">
              {{ csrf_field() }}
              <label for="binding-code">正版登录验证码</label>
              <input id="binding-code" name="code" class="form-control" minlength="6" maxlength="6" pattern="[0-9]{6}" inputmode="numeric" autocomplete="one-time-code" required>
              <button type="submit" class="btn btn-primary btn-block mt-2">确认绑定</button>
            </form>
            <p class="text-muted small mt-2 mb-0">请使用 Minecraft 1.20.5 或更高版本。验证码 10 分钟内有效，请勿转发。</p>
          </div>
          <div class="card-footer">
            <form method="POST" action="{{ url('yggdrasil/mojang/cancel-bind') }}">
              {{ csrf_field() }}
              <button type="submit" class="btn btn-secondary btn-block">
                <i class="fas fa-times mr-1"></i>取消申请
              </button>
            </form>
          </div>
        </div>

      {% else %}

        {% if not hasPlayer %}
        <div class="callout callout-warning">
          <h5><i class="fas fa-exclamation-triangle mr-1"></i>需要先创建角色</h5>
          <p class="mb-0">
            绑定前请先在<a href="{{ url('user/player') }}">角色管理</a>页面创建一个角色。
            没有角色时即使通过验证也无法完成绑定。
          </p>
        </div>
        {% endif %}

        <div class="card {% if not hasPlayer %}card-secondary{% else %}card-primary{% endif %}">
          <div class="card-header">
            <h3 class="card-title"><i class="fas fa-gamepad mr-2"></i>绑定 Minecraft 正版账号</h3>
          </div>
          <div class="card-body">
            <div class="callout callout-info">
              绑定后，可用正版账号登录 Minecraft 并直接加入服务器，与皮肤站账号共享角色数据（背包、进度等）。
            </div>
            <form method="POST" action="{{ url('yggdrasil/mojang/bind') }}">
              {{ csrf_field() }}
              <div class="form-group">
                <label for="mojang_name">Minecraft 正版用户名</label>
                <input type="text" id="mojang_name" name="mojang_name"
                  class="form-control" placeholder="例：Steve"
                  maxlength="16" required
                  {% if not hasPlayer %}disabled{% endif %}>
                <small class="form-text text-muted">无需在意大小写，提交后会自动从 Mojang 校正为规范用户名</small>
              </div>
              <button type="submit" class="btn btn-primary btn-block"
                {% if not hasPlayer %}disabled{% endif %}>
                <i class="fas fa-check mr-1"></i>提交并等待验证
              </button>
            </form>
          </div>
          <div class="card-footer bg-transparent">
            <div class="row text-center text-muted small" style="row-gap: 1rem;">
              <div class="col-12 col-sm-4 d-flex flex-column align-items-center">
                <i class="fas fa-keyboard mb-2" aria-hidden="true" style="font-size:1.4em; width:1.5em; height:1.5em; line-height:1.5;"></i>
                <span>① 填写用户名</span>
              </div>
              <div class="col-12 col-sm-4 d-flex flex-column align-items-center">
                <i class="fas fa-server mb-2" aria-hidden="true" style="font-size:1.4em; width:1.5em; height:1.5em; line-height:1.5;"></i>
                <span>② 进入服务器</span>
              </div>
              <div class="col-12 col-sm-4 d-flex flex-column align-items-center">
                <i class="fas fa-check-circle mb-2" aria-hidden="true" style="font-size:1.4em; width:1.5em; height:1.5em; line-height:1.5;"></i>
                <span>③ 验证码确认</span>
              </div>
            </div>
          </div>
        </div>

      {% endif %}

    </div>
  </div>
</div>
{% endblock %}
